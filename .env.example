# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase Edge Functions (server-side only, never expose to client) ───────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic / Claude API ──────────────────────────────────────────────────
# Found in: console.anthropic.com → API Keys
# Used in: Supabase Edge Functions (server-side only)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Google Cloud Vision API ─────────────────────────────────────────────────
# Found in: console.cloud.google.com → APIs & Services → Credentials
# Used in: Supabase Edge Functions (server-side only)
GOOGLE_VISION_API_KEY=AIzaSy-your-key-here

# ─── remove.bg API ───────────────────────────────────────────────────────────
# Found in: remove.bg/dashboard → API Keys
# Free tier: 50 API calls/month
# Used in: Supabase Edge Functions (server-side only)
REMOVE_BG_API_KEY=your-removebg-key-here

# ─── EAS (Expo Application Services) ────────────────────────────────────────
# Found in: expo.dev → Project Settings
EAS_PROJECT_ID=your-eas-project-id-here

# ─── App variant (development | preview | production) ────────────────────────
APP_VARIANT=development
